<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup><Reference Include="bg3sim"><HintPath>$(SimulatorAssembly)</HintPath></Reference></ItemGroup>
  <Target Name="RequireSimulatorAssembly" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(SimulatorAssembly)' == ''" Text="Supply -p:SimulatorAssembly=/absolute/path/to/bg3sim.dll explicitly." />
    <Error Condition="'$(SimulatorAssembly)' != '' and !Exists('$(SimulatorAssembly)')" Text="SimulatorAssembly does not exist: $(SimulatorAssembly)" />
  </Target>
</Project>
